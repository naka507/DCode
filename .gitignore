# Dependencies
node_modules/
.pnpm-store/

# Build
dist/
out/
build/
# The packaged icons, DMG background, and entitlements live in the root
# `build/` directory and are referenced by `package.json`'s electron-builder
# config, so they are committed; only generated output is not.
!build/
build/icon.iconset/
docs/.vitepress/cache/
docs/.vitepress/dist/
release/
target/
*.tsbuildinfo
# The sidecar bundle is generated by `npm run build:sidecar` and copied into the
# package by electron-builder's `extraResources`; it is never committed.
resources/runtime/

# Local design-source exports. These are the inputs to
# `scripts/make-brand-marks.py` and `scripts/make-dmg-background.py`, never
# repository content; each script takes the directory or file that holds them,
# so the patterns are unanchored and keep the sources out of the repository
# wherever they are kept. No tracked file shares these names.
logo.png
home.png
mascot.gif
dmg.jpg
*.tgz

# Env / secrets
.env
.env.*
!.env.example
*.local

